# Test-mode environment example. Copy to ~/.config/pifitness/test.env,
# fill in any secrets there, and protect it (chmod 0600). test-up requires
# this external file before it stops any production service. Passwords and
# tokens are intentionally NOT stored in this tracked example.
APP_ENV=test

PG_HOST=localhost
PG_PORT=15432
PG_DB=pifitness_test
PG_USER=dev
PGSSLMODE=disable

BOX=local

# Integrations disabled in test mode
SPOTIFY_ENABLED=false
GARMIN_ENABLED=false
PIRATE_ENABLED=false