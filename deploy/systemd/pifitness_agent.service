[Unit]
Description=PiFitness Background Task Execution
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=god
Group=god
WorkingDirectory=@APP_DIR@/backend
Environment="PATH=@VENV_DIR@/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=@APP_DIR@/backend/.env
ExecStart=@VENV_DIR@/bin/python3 -m pifitness.worker.background_task_execution
StandardOutput=journal
StandardError=journal

# Kill the run if it exceeds this duration
RuntimeMaxSec=28min

# Give the process this long to handle SIGTERM before SIGKILL
TimeoutStopSec=30


# Security hardening (mirrors FastAPI service)
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=@APP_DIR@ /home/god/Documents/PiFitness_Local /home/god/Documents/DB_Backups