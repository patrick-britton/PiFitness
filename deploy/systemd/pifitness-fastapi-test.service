[Unit]
Description=PiFitness FastAPI Backend (TEST)
After=network.target postgresql.service
Wants=postgresql.service
Conflicts=pifitness-fastapi.service

[Service]
Type=simple
User=god
Group=god
WorkingDirectory=/home/god/PiFitness-test
EnvironmentFile=/home/god/.config/pifitness/test.env
ExecStart=/home/god/PiFitness-test/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/god/PiFitness-test /home/god/Documents/PiFitness_Test_Local

[Install]
WantedBy=multi-user.target
