[Unit]
Description=PiFitness FastAPI Backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=god
Group=god
WorkingDirectory=/home/god/PiFitness
EnvironmentFile=/home/god/PiFitness/.env   # ensure .env is at this location
ExecStart=/home/god/PiFitness/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/god/PiFitness

[Install]
WantedBy=multi-user.target